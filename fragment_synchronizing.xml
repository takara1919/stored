<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.synchroniz.SynchronizingFragment">

    <ImageView
        android:id="@+id/ivBack"
        android:layout_width="?attr/actionBarSize"
        android:layout_height="?attr/actionBarSize"
        android:padding="6dp"
        android:src="@drawable/ic_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/ivBanner"
        android:layout_width="0dp"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintWidth_percent="0.34"
        app:layout_constraintVertical_bias="0.2"
        android:src="@drawable/ic_banner_stop"
        app:layout_constraintTop_toBottomOf="@id/ivBack"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_height="0dp"/>

    <TextView
        android:id="@+id/tvYouNeed"
        android:layout_width="0dp"
        android:gravity="center"
        android:layout_marginHorizontal="24dp"
        app:layout_constraintTop_toBottomOf="@id/ivBanner"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/poppins_regular"
        android:textColor="@color/black"
        android:text="@string/you_need_to_be_logged"
        android:layout_height="wrap_content"/>

    <TextView
        android:id="@+id/tvLogin"
        android:layout_width="0dp"
        app:layout_constraintDimensionRatio="266:48"
        app:layout_constraintTop_toBottomOf="@id/tvYouNeed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="32dp"
        android:text="@string/loginLabel"
        android:gravity="center"
        android:fontFamily="@font/poppins_semi_bold"
        android:textSize="16sp"
        android:textColor="@color/white"
        android:background="@drawable/bg_blue_radius_100dp"
        app:layout_constraintWidth_percent="0.73"
        android:layout_height="0dp"/>

    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/lvSys"
        android:layout_width="0dp"
        app:layout_constraintDimensionRatio="256:213"
        app:layout_constraintWidth_percent="0.71"
        app:lottie_autoPlay="true"
        app:lottie_loop="true"
        app:lottie_fileName="loading.json"
        app:layout_constraintTop_toBottomOf="@id/ivBack"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_height="0dp"/>

    <TextView
        android:id="@+id/tvSys"
        android:layout_width="wrap_content"
        android:text="@string/synchronizing"
        app:layout_constraintTop_toBottomOf="@id/lvSys"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:textColor="#008FFF"
        android:textSize="15sp"
        android:fontFamily="@font/poppins_semi_bold"
        android:layout_height="wrap_content"/>

    <FrameLayout
        android:id="@+id/flAds"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</androidx.constraintlayout.widget.ConstraintLayout>